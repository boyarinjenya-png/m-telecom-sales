# M-TELECOM SALES — example configuration
# Copy this file to .env on the server and fill in real values.
# Never commit .env, passwords, or API keys to GitHub.
# Local test users: copy backend/config/seed.local.example.php
# to backend/config/seed.local.php (gitignored). Do not set SEED_* in production.

APP_NAME="M-TELECOM SALES"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sales.mtelecom.kz
APP_TIMEZONE=Asia/Almaty
APP_KEY=change-me-to-a-long-random-string

# Database (separate from the main M-Telecom website)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mtelecom_sales
DB_USER=mtelecom_sales
DB_PASS=
DB_CHARSET=utf8mb4

# Alternative path deployment, e.g. https://mtelecom.kz/sales
# APP_BASE_PATH=/sales

# Auth
TOKEN_TTL_HOURS=720
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Uploads
UPLOAD_MAX_MB=5

# Android app version advertised by the API
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0
ANDROID_APK_URL=

# Optional map tile server (default: OpenStreetMap, no API key)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
