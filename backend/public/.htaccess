# M-TELECOM SALES — Apache front controller
# Document root should point here (subdomain or /sales directory).
# Do not place this file in the main M-Telecom website root.

Options -Indexes
RewriteEngine On

<FilesMatch "(^\.env|composer\.(json|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# After install.lock exists, installer cannot be opened again.
# Works when this directory is the document root, when the app root is
# the document root, and when the app lives at httpdocs/sales.
RewriteCond %{DOCUMENT_ROOT}/install.lock -f [OR]
RewriteCond %{DOCUMENT_ROOT}/backend/public/install.lock -f [OR]
RewriteCond %{DOCUMENT_ROOT}/sales/backend/public/install.lock -f
RewriteRule ^install\.php$ - [F,L]

# Keep real files (assets, install.php before lock)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
</IfModule>
